{{define "search"}}
<div class="search-wrap">
  {{iconAt "search" 18}}
  {{/* #results is swapped whole, so the fragment must include the wrapper id. */}}
  <input type="search" name="q" value="{{.Query}}" placeholder="{{.SearchLabel}}" aria-label="{{.SearchLabel}}" autocomplete="off"
    hx-get="{{.Path}}" hx-target="#results" hx-swap="outerHTML"
    hx-trigger="input changed delay:200ms, search" />
</div>
{{end}}

{{define "post-card"}}
<div class="card">
  <div class="mb-3">
    <a href="/post/{{.Slug}}" class="post-title"><span class="label">{{.Title}}</span>{{iconAt "chevron-right" 14}}</a>
    <p class="desc">{{.Description}}</p>
  </div>
  <div class="row">
    <div class="row-tight">
      <span class="badge">{{iconAt "tag" 12}}<span>{{.Category}}</span></span>
      <span class="badge">{{iconAt "cal" 12}}<time datetime="{{.Date}}">{{formatDate .Date}}</time></span>
    </div>
  </div>
</div>
{{end}}

{{define "pager"}}
{{if gt .TotalPages 1}}
<nav class="pager" aria-label="Pagination">
  {{if .PrevURL}}<button class="btn btn-outline btn-sm" hx-get="{{.PrevURL}}" hx-target="#results" hx-swap="outerHTML">Previous</button>{{else}}<button class="btn btn-outline btn-sm" disabled>Previous</button>{{end}}
  <p class="pager-label" aria-live="polite">Page {{.Page}} of {{.TotalPages}}</p>
  {{if .NextURL}}<button class="btn btn-outline btn-sm" hx-get="{{.NextURL}}" hx-target="#results" hx-swap="outerHTML">Next</button>{{else}}<button class="btn btn-outline btn-sm" disabled>Next</button>{{end}}
</nav>
{{end}}
{{end}}